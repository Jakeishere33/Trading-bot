services:
  - type: web
    name: multi-factor-risk-engine
    env: python
    plan: starter
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn trading_bot:app --workers 1 --bind 0.0.0.0:$PORT
    envVars:
      - key: PYTHON_VERSION
        value: 3.11.9
      - key: ALPACA_API_KEY
        sync: false
      - key: ALPACA_API_SECRET
        sync: false
      - key: ALPACA_PAPER
        value: "true"
